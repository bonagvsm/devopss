NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=taskflow
DB_PASSWORD=taskflow_dev_password
DB_NAME=taskflow

# Daftar origin yang boleh memanggil API dari browser, pisahkan dengan koma.
# Kosong = CORS mati (cukup jika frontend dan API satu origin lewat proxy/nginx).
CORS_ORIGIN=

# Batas request per IP untuk /api
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Jumlah proxy di depan backend (0 = tanpa proxy; 1 = nginx/ingress)
TRUST_PROXY=0

# Batas waktu menunggu request selesai saat shutdown
SHUTDOWN_TIMEOUT_MS=10000
